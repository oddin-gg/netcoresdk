<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>Oddin.OddsFeedSdk</AssemblyName>
    <RootNamespace>Oddin.OddsFeedSdk</RootNamespace>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <LangVersion>10</LangVersion>
    <AssemblyVersion>1.1.34.0</AssemblyVersion>
    <FileVersion>1.1.34.0</FileVersion>
    <Version>1.1.34</Version>
    <PackageId>Oddin.OddsFeedSdk</PackageId>
    <Description>Oddin.gg Odds Feed SDK for .NET</Description>
    <Authors>Oddin.gg</Authors>
    <Company>Oddin.gg</Company>
    <PackageLicenseExpression>BSD-3-Clause</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/oddin-gg/netcoresdk</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/oddin-gg/netcoresdk</PackageProjectUrl>
    <PackageTags>oddin;odds;feed;esports;sdk</PackageTags>
    <Copyright>Copyright (c) 2020, Oddin.gg</Copyright>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!-- CI builds map source paths to the repository, so the symbols and SourceLink do not carry the runner's paths -->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\..\README.md" Pack="true" PackagePath="\" Visible="false"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All"/>
    <PackageReference Include="Flurl" Version="3.0.6"/>
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="6.0.1"/>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="6.0.1"/>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="6.0.2"/>
    <PackageReference Include="RabbitMQ.Client" Version="6.4.0"/>
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="6.0.1"/>
    <PackageReference Include="System.Reactive" Version="5.0.0"/>
    <PackageReference Include="System.Runtime.Caching" Version="6.0.0"/>
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Oddin.OddsFeedSdk.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>